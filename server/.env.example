PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/subtrack?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173

# Two different long random strings
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_ACCESS_EXPIRES_IN=15m

# Email (optional). Without these, emails are printed in the server terminal.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<16-char app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Or Brevo's HTTP email API (needed on hosts that block SMTP, e.g. Render's free plan). Used instead of SMTP when set.
# EMAIL_FROM must be a sender address verified in Brevo.
# BREVO_API_KEY=

# Renewal reminder job (cron syntax), runs in this timezone
REMINDER_CRON=0 9 * * *
REMINDER_TIMEZONE=Asia/Kolkata

# Browser push notifications. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# AI assistant (https://console.anthropic.com -> API keys). Leave empty to hide the assistant.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5
# AI_REQUESTS_PER_HOUR=30

# Free alternative: Google Gemini (https://aistudio.google.com/apikey). Used when no Anthropic key is set.
# With neither key, the assistant uses built-in rule-based answers.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest  (default; "gemini-flash-latest" is the backup)

# WhatsApp messages from each user's own WhatsApp, linked by scanning a QR code in Settings -> WhatsApp.
# Anyone can receive them without joining anything, but it's unofficial: WhatsApp may ban numbers that send
# automated messages. Without it, WhatsApp messages are printed in the server terminal instead of being sent.
# WHATSAPP_PROVIDER=web
# Country code added to 10-digit phone numbers
# DEFAULT_COUNTRY_CODE=91

# Optional: separate key for encrypting 2FA secrets (defaults to one derived from JWT_SECRET)
# ENCRYPTION_KEY=

# Monthly PDF report email (cron syntax): 9:00 on the 1st
REPORT_CRON=0 9 1 * *
