{
  "name": "SubTrack - SaaS Spend Analytics",
  "short_name": "SubTrack",
  "description": "Track SaaS subscriptions, renewals and spending.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fafaf9",
  "theme_color": "#2a78d6",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Add subscription", "url": "/subscriptions?new=1" },
    { "name": "Add expense", "url": "/expenses?new=1" },
    { "name": "Renewal calendar", "url": "/calendar" }
  ]
}
